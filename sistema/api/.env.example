# Copie pra .env (não versionado) e ajuste.

NODE_ENV=development
PORT=3333

# Marca produção sem usar NODE_ENV. Na Netlify é esta que vale: lá o
# NODE_ENV=production no build faz o `npm install` pular as devDependencies
# (TypeScript, Vite) e o build quebra. Valores: desenvolvimento | producao.
AMBIENTE=

# `arquivo` grava em ./dados (dev). `blobs` usa Netlify Blobs (produção serverless).
ARMAZENAMENTO=arquivo
DATA_DIR=./dados

# De onde o painel e o site podem chamar a API em dev.
ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:4321

# Chave que o carrinho do site manda no header `x-chave-site`.
# Vazia desliga as rotas de cupom e de pedido do site.
# Ela vive no bundle do site, então é barreira contra bot, não segredo:
# só permite criar pedido em rascunho.
CHAVE_SITE=troque-esta-chave

# --- Acesso ao painel ---

# Senha única de entrada no back-office. Mínimo 12 caracteres.
# Vazia: em desenvolvimento o painel abre sem login; em produção as rotas de
# gestão respondem 503 (melhor indisponível que aberto na internet).
SENHA_PAINEL=

# Opcional. Assina o cookie de sessão. Sem ele, a chave é derivada da senha —
# o que faz trocar a senha derrubar as sessões abertas, e isso é desejado.
# Se preencher, use algo aleatório: `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
SEGREDO_SESSAO=

# Quanto tempo a sessão dura, em horas.
SESSAO_HORAS=12
