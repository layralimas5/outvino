---
/**
 * Ícones da ficha técnica do rótulo.
 *
 * Desenhados no mesmo traço fino do resto da interface (1.4 em viewBox de 24),
 * sem preenchimento: numa ficha com sete linhas, ícone cheio pesa mais que o
 * texto e rouba a leitura. Herdam `currentColor`.
 */
export type NomeDaFicha = 'uva' | 'classificacao' | 'safra' | 'amadurecimento' | 'teor' | 'temperatura' | 'guarda' | 'volume' | 'pais' | 'regiao' | 'vinicola' | 'tipo';

interface Props {
  nome: NomeDaFicha;
  class?: string;
}

const { nome, class: classe = 'size-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={classe}
>
  {/* Cacho: três fileiras de bagas com o galho em cima. */}
  {
    nome === 'uva' && (
      <>
        <path d="M12 5.5V8" />
        <path d="M12 5.5c1.2-1.4 2.7-1.9 4-1.8-.1 1.4-.8 2.6-2.1 3.2" />
        <circle cx="9.4" cy="10" r="1.9" />
        <circle cx="14.6" cy="10" r="1.9" />
        <circle cx="12" cy="13.6" r="1.9" />
        <circle cx="7.6" cy="14.4" r="1.9" />
        <circle cx="16.4" cy="14.4" r="1.9" />
        <circle cx="12" cy="18.2" r="1.9" />
      </>
    )
  }

  {/* Gota meio preenchida: quanto de açúcar sobra no vinho. */}
  {
    nome === 'classificacao' && (
      <>
        <path d="M12 3.2c3.4 3.7 5.2 6.4 5.2 8.9a5.2 5.2 0 0 1-10.4 0c0-2.5 1.8-5.2 5.2-8.9Z" />
        <path
          d="M12 3.2v17.1a5.2 5.2 0 0 1-5.2-5.2c0-2.5 1.8-5.2 5.2-8.9Z"
          fill="currentColor"
          stroke="none"
          opacity="0.18"
        />
      </>
    )
  }

  {/* Calendário da colheita. */}
  {
    nome === 'safra' && (
      <>
        <rect x="3.5" y="5.5" width="17" height="15" rx="2.5" />
        <path d="M3.5 10h17" />
        <path d="M8 3.5v4M16 3.5v4" />
        <path d="M8.5 14h3M8.5 17h7" />
      </>
    )
  }

  {/* Barrica deitada, com as aduelas. */}
  {
    nome === 'amadurecimento' && (
      <>
        <path d="M6.5 5.5h11c1.1 2 1.7 4.2 1.7 6.5s-.6 4.5-1.7 6.5h-11C5.4 16.5 4.8 14.3 4.8 12s.6-4.5 1.7-6.5Z" />
        <path d="M10 5.5c-.7 2-1.1 4.2-1.1 6.5s.4 4.5 1.1 6.5" />
        <path d="M14 5.5c.7 2 1.1 4.2 1.1 6.5s-.4 4.5-1.1 6.5" />
        <path d="M4.9 9h14.2M4.9 15h14.2" />
      </>
    )
  }

  {/* Taça: o grau alcoólico. */}
  {
    nome === 'teor' && (
      <>
        <path d="M7 3.5h10l-.7 5.2a4.4 4.4 0 0 1-8.6 0Z" />
        <path d="M12 13.1v6.4" />
        <path d="M8.5 20.5h7" />
      </>
    )
  }

  {/* Termômetro. */}
  {
    nome === 'temperatura' && (
      <>
        <path d="M10 13.6V5.2a2 2 0 1 1 4 0v8.4a4 4 0 1 1-4 0Z" />
        <path d="M12 9.5v6.2" />
        <circle cx="12" cy="17.6" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Ampulheta: quanto tempo o vinho ainda tem. */}
  {
    nome === 'guarda' && (
      <>
        <path d="M6.5 3.5h11M6.5 20.5h11" />
        <path d="M7.5 3.5c0 3.4 1.5 6.3 4.5 8.5-3 2.2-4.5 5.1-4.5 8.5" />
        <path d="M16.5 3.5c0 3.4-1.5 6.3-4.5 8.5 3 2.2 4.5 5.1 4.5 8.5" />
        <path d="M9.6 18.5h4.8" stroke-width="2" />
      </>
    )
  }

  {/* Garrafa. */}
  {
    nome === 'volume' && (
      <>
        <path d="M10.2 2.8h3.6v4.1c0 .6.2 1.1.6 1.6l.9 1.1c.5.6.7 1.3.7 2v8.1a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2v-8.1c0-.7.2-1.4.7-2l.9-1.1c.4-.5.6-1 .6-1.6Z" />
        <path d="M8 13.5h8" />
      </>
    )
  }

  {/* Globo: país de origem. */}
  {
    nome === 'pais' && (
      <>
        <circle cx="12" cy="12" r="8.7" />
        <path d="M3.3 12h17.4" />
        <path d="M12 3.3c2.2 2.4 3.4 5.4 3.4 8.7s-1.2 6.3-3.4 8.7c-2.2-2.4-3.4-5.4-3.4-8.7S9.8 5.7 12 3.3Z" />
      </>
    )
  }

  {/* Alfinete no mapa: região. */}
  {
    nome === 'regiao' && (
      <>
        <path d="M12 21.2c3.6-4.1 5.4-7.2 5.4-9.4a5.4 5.4 0 1 0-10.8 0c0 2.2 1.8 5.3 5.4 9.4Z" />
        <circle cx="12" cy="11.4" r="2.1" />
      </>
    )
  }

  {/* Casa com parreiral: a vinícola. */}
  {
    nome === 'vinicola' && (
      <>
        <path d="M4 20.5v-9l8-5.5 8 5.5v9" />
        <path d="M2.8 20.5h18.4" />
        <path d="M10 20.5v-4.6h4v4.6" />
        <path d="M9.5 11.3h5" />
      </>
    )
  }

  {/* Taça com a marca do tipo. */}
  {
    nome === 'tipo' && (
      <>
        <path d="M6.6 3.5h10.8l-.6 6a5 5 0 0 1-9.6 0Z" />
        <path d="M12 14.6v5.9M8.6 20.5h6.8" />
        <path d="M7.1 8.5h9.8" />
      </>
    )
  }
</svg>
