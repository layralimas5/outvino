---
/**
 * Placeholder de garrafa enquanto não há foto do produto.
 *
 * SVG inline em vez de imagem: pesa quase nada, escala sem borrar e a cor
 * muda com o tipo do vinho, então a vitrine não fica uma parede de cinza.
 */
interface Props {
  tipo: string;
  class?: string;
}

const { tipo, class: classe = '' } = Astro.props;

const CORES: Record<string, [string, string]> = {
  Tinto: ['#5c1220', '#2a0a11'],
  Branco: ['#c8b271', '#6b5c33'],
  Rosé: ['#c9707f', '#6d3540'],
  Espumante: ['#d9c07f', '#7a6533'],
  Sobremesa: ['#a8642a', '#4f2d13'],
  Kit: ['#4a3a44', '#221a20'],
};

const [claro, escuro] = CORES[tipo] ?? CORES.Kit!;
const id = `garrafa-${tipo.toLowerCase().replace(/[^a-z]/g, '')}`;
---

<svg
  viewBox="0 0 120 200"
  role="img"
  aria-label={`Ilustração de garrafa de vinho ${tipo.toLowerCase()}`}
  class={classe}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color={escuro} />
      <stop offset="45%" stop-color={claro} />
      <stop offset="100%" stop-color={escuro} />
    </linearGradient>
  </defs>

  <path
    d="M52 8h16v38c0 8 3 12 8 18 6 7 9 14 9 24v96a8 8 0 0 1-8 8H43a8 8 0 0 1-8-8V88c0-10 3-17 9-24 5-6 8-10 8-18V8Z"
    fill={`url(#${id})`}
  />
  <rect x="35" y="104" width="50" height="46" rx="2" fill="#f6f1ea" opacity="0.9" />
  <rect x="41" y="116" width="38" height="2" fill={escuro} opacity="0.55" />
  <rect x="41" y="124" width="26" height="2" fill={escuro} opacity="0.35" />
  <rect x="41" y="132" width="32" height="2" fill={escuro} opacity="0.35" />
  <path d="M52 8h16v10H52z" fill="#0b0709" opacity="0.55" />
</svg>
