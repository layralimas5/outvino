---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config/site';
import { linkDeContato } from '../lib/whatsapp';

interface Props {
  title: string;
  description: string;
  /** Resumo em uma frase, logo abaixo do título. */
  resumo: string;
  /** Data da última revisão do texto, no formato dd/mm/aaaa. */
  atualizadoEm: string;
  /** JSON-LD específico da página, repassado ao layout base. */
  schema?: Record<string, unknown>;
}

const { title, description, resumo, atualizadoEm, schema } = Astro.props;

/**
 * Identificação do fornecedor exigida pelo Decreto 7.962/2013. Só entra na
 * página quando os dados existirem de verdade em `site.ts`, porque texto legal com
 * CNPJ inventado é pior do que texto legal ausente.
 */
const { empresa, address } = SITE;
const enderecoCompleto = [address.street, address.city, address.state, address.postalCode]
  .filter(Boolean)
  .join(', ');
const identificacao = [
  { rotulo: 'Razão social', valor: empresa.razaoSocial },
  { rotulo: 'CNPJ', valor: empresa.cnpj },
  { rotulo: 'Endereço', valor: enderecoCompleto },
  { rotulo: 'E-mail', valor: empresa.email },
].filter((linha) => Boolean(linha.valor));
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="border-b border-papel-200 bg-papel-50">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 md:py-16">
      <nav aria-label="Trilha de navegação" class="text-xs text-tinta-500">
        <a href="/" class="transition-colors hover:text-vinho-600">Início</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span class="text-tinta-700">{title}</span>
      </nav>

      <h1 class="mt-4 font-display text-4xl leading-[1.1] sm:text-5xl">{title}</h1>

      <p class="mt-5 text-lg leading-relaxed">{resumo}</p>

      <p class="mt-6 text-xs text-tinta-500">Última atualização: {atualizadoEm}</p>
    </div>
  </section>

  <div class="texto-legal mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <slot />

    {
      identificacao.length > 0 && (
        <section>
          <h2>Quem é o fornecedor</h2>
          <dl class="mt-4 divide-y divide-papel-200 border-y border-papel-200">
            {identificacao.map((linha) => (
              <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-3 text-sm">
                <dt class="text-tinta-500">{linha.rotulo}</dt>
                <dd class="text-right text-tinta-700">{linha.valor}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section>
      <h2>Ficou com dúvida?</h2>
      <p>
        Qualquer ponto desse texto a gente explica em português no WhatsApp, no horário da loja
        ({SITE.openingHours.toLowerCase()}).
      </p>
      <p>
        <a href={linkDeContato(`Oi! Tenho uma dúvida sobre a página "${title}" do site.`)}
          target="_blank"
          rel="noreferrer">
          Falar com a gente no WhatsApp
        </a>
      </p>
    </section>

    <p class="mt-12 text-center text-xs text-tinta-500">
      Venda proibida para menores de 18 anos. Aprecie com moderação.
    </p>
  </div>
</BaseLayout>
