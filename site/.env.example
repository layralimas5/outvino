# Copie para `.env` (local) ou configure no painel da Netlify.
#
# As duas variáveis são opcionais: sem elas o carrinho continua funcionando e
# manda o pedido direto pro WhatsApp, só não registra o rascunho no sistema.
#
# `PUBLIC_` é obrigatório no prefixo: é assim que o Astro expõe a variável pro
# navegador. Nada de segredo de verdade aqui: o valor viaja no bundle.

# Endereço da API do back-office, sem barra no fim.
PUBLIC_API_URL=http://localhost:3333

# Mesmo valor de CHAVE_SITE na API. Barreira contra bot, não segredo.
PUBLIC_CHAVE_SITE=

# Endereço do back-office, pro atalho no cabeçalho do site. Sem ela, o link
# cai no padrão do `site.ts` (Vite local em dev, subdomínio do sistema em prod).
PUBLIC_SISTEMA_URL=

# Só pro `npm run sync` (roda na sua máquina, não no build da Netlify).
API_URL=http://localhost:3333
