# Dependências e build
node_modules/
dist/
.astro/
*.tsbuildinfo

# Ambiente — nunca commitar. O `.env.example` é o que fica versionado.
.env
.env.*
!.env.example

# Netlify
.netlify/

# Estado de execução da API em disco: pedido, cliente e movimento de estoque.
